# ============================================
# XSS Learning Lab - Environment Variables Example
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development # Set to 'production' in production deployments

# MongoDB Connection
# Replace with your local MongoDB URI or MongoDB Atlas Cloud URI
MONGODB_URI=mongodb://localhost:27017/xss-learning-lab

# CORS Configuration
# Set this to your frontend URL in production (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173
